<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BugScreen SDK Privacy Manifest

  This privacy manifest declares the SDK's data collection and API usage practices
  for App Store submission. Required for iOS 17+ apps.

  Key Points:
  - Diagnostic evidence is sent only when the user explicitly submits a bug report
  - System-log snapshots require developer opt-in and read only the current process
  - Optional, explicitly enabled screen recording keeps a bounded silent buffer locally while the host app is foregrounded
  - Recording requires OS consent; the tester can review or remove its clip before submitting
  - Report data is transmitted only when the user explicitly submits a bug report
  - All collected data is used solely for app functionality (issue triage)
  - No tracking, no linking to identity, no third-party data sharing
  - Uses system boot time API for log timestamps
-->
<plist version="1.0">
<dict>
	<!-- API Usage -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- System Boot Time API -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1: Measure time or duration -->
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!-- Data Collection -->
	<!--
	  All entries describe data sent only when the user explicitly submits a bug
	  report. Every type is collected for app functionality (issue triage), is
	  not linked to the user's identity, and is not used for tracking.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  No NSPrivacyCollectedDataTypeDeviceID entry, deliberately. The device model
		  MetadataCollector reads from uname (e.g. iPhone15,2) names a hardware model shared by
		  every unit of that model — it identifies no device and no person, so it is diagnostic
		  data, not an identifier. Apple tolerates over-declaring, but this manifest is read
		  alongside the privacy policy (MKT-007), where declaring a device ID would contradict the
		  disclosure that the SDK collects nothing device-identifying. See CAP-005.
		-->

		<!-- Device/app metadata, custom log buffer, and optional current-process unified-log snapshot.
		     System logs preserve OS redactions; developers must avoid sensitive host-log content. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectionPurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Screenshots, user-selected videos and optional silent recent-screen clips (sent only on explicit submit) -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectionPurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Free-text bug description authored by the user -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectionPurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Tracking -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- Tracking Domains -->
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<!-- No tracking domains -->
	</array>
</dict>
</plist>
