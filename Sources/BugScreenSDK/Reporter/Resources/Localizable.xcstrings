          "stringUnit": {
            "state": "translated",
            "value": "Add a short description."
          }
        }
      }
    },
    "validation.description.too_long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description is too long. Please shorten it to under 10,000 characters."
          }
        }
      }
    },
    "validation.file_too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachment is too large. The limit is 2 MB."
          }
        }
      }
    },
